# MongoDB connection string (Atlas or local).
MONGODB_URI=

# Secret used to sign JSON Web Tokens. Use a long random string.
JWT_SECRET=

# Public base URL of this app. Used for OAuth callbacks and password reset
# links. In production this must be the externally reachable URL.
APP_URL=http://localhost:3000

# Google OAuth 2.0 credentials (optional). Leave blank to hide Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Twitter OAuth 1.0a credentials (optional). Leave blank to hide Twitter
# sign-in. The Twitter app must be allowed to request the user's email.
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=

# Gmail SMTP credentials used to send password reset emails (optional).
EMAIL_ADDRESS=
EMAIL_PASSWORD=

# Public links and addresses shown in the UI.
NEXT_PUBLIC_DONATION_LINK=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_FEEDBACK_EMAIL=
